})  # observeEvent结束
tryCatch({
# 验证项目是否已初始化
if (is.null(prj_init$wd) || !dir.exists(prj_init$wd)) {
shinyalert("Error", "Project not initialized. Please initialize project first.", type = "error")
return()
}
# 设置处理状态
processing_status("processing")
# 目标目录
target_dir <- file.path(prj_init$wd, "MS1")
# 删除已存在的目录（如果存在）
if (dir.exists(target_dir)) {
unlink(target_dir, recursive = TRUE)
}
# 确保目标目录存在
dir.create(target_dir, showWarnings = FALSE, recursive = TRUE)
# 根据选择的方式处理
if (input$ms1_source == "upload") {
# 处理上传的ZIP文件
req(input$ms1_zip)
zip_file <- input$ms1_zip$datapath
# 验证文件类型
if (!grepl("\\.zip$", input$ms1_zip$name, ignore.case = TRUE)) {
shinyalert("Error", "Please upload a ZIP file", type = "error")
processing_status("error")
return()
}
# 解压文件
withProgress(
message = 'Extracting ZIP file',
detail = 'This may take a while...',
value = 0.5,
{
unzip(zip_file, exdir = target_dir)
}
)
# 显示成功消息
shinyalert("Success", "ZIP file uploaded and extracted successfully", type = "success")
} else if (input$ms1_source == "url") {
# 处理URL下载
req(input$ms1_url)
url <- input$ms1_url
# 验证URL格式
if (!grepl("^https?://", url)) {
shinyalert("Error", "Please enter a valid URL starting with http:// or https://", type = "error")
processing_status("error")
return()
}
if (!grepl("\\.zip$", url, ignore.case = TRUE)) {
shinyalert("Error", "URL must point to a .zip file", type = "error")
processing_status("error")
return()
}
# 创建临时文件
temp_zip <- tempfile(fileext = ".zip")
# 下载文件
withProgress(
message = 'Downloading ZIP file',
detail = 'This may take a while...',
value = 0.3,
{
tryCatch({
download.file(url, destfile = temp_zip, mode = "wb")
}, error = function(e) {
shinyalert("Download Failed", paste("Error:", e$message), type = "error")
processing_status("error")
return()
})
}
)
# 解压文件
withProgress(
message = 'Extracting files',
detail = 'Please wait...',
value = 0.6,
{
tryCatch({
unzip(temp_zip, exdir = target_dir)
}, error = function(e) {
shinyalert("Extraction Failed", paste("Error:", e$message), type = "error")
processing_status("error")
return()
})
}
)
# 删除临时文件
unlink(temp_zip)
# 显示成功消息
shinyalert("Success", "File downloaded and extracted successfully", type = "success")
}
# 检查并修正目录结构
withProgress(
message = 'Organizing directory structure',
detail = 'Checking folder layout...',
value = 0.9,
{
# 获取解压后的文件列表
extracted_files <- list.files(target_dir, full.names = TRUE)
# 修正1: 修复括号不匹配的if条件
if (length(extracted_files) == 1 && dir.exists(extracted_files[1])) {
subdir <- extracted_files[1]
subdir_name <- basename(subdir)
# 检查子目录是否包含POS/NEG目录
if (any(dir.exists(file.path(subdir, c("POS", "NEG")))) {
# 处理MS1文件
observeEvent(input$process_ms1, {
tryCatch({
# 验证项目是否已初始化
if (is.null(prj_init$wd) || !dir.exists(prj_init$wd)) {
shinyalert("Error", "Project not initialized. Please initialize project first.", type = "error")
return()
}
# 设置处理状态
processing_status("processing")
# 目标目录
target_dir <- file.path(prj_init$wd, "MS1")
# 删除已存在的目录（如果存在）
if (dir.exists(target_dir)) {
unlink(target_dir, recursive = TRUE)
}
# 确保目标目录存在
dir.create(target_dir, showWarnings = FALSE, recursive = TRUE)
# 根据选择的方式处理
if (input$ms1_source == "upload") {
# 处理上传的ZIP文件
req(input$ms1_zip)
zip_file <- input$ms1_zip$datapath
# 验证文件类型
if (!grepl("\\.zip$", input$ms1_zip$name, ignore.case = TRUE)) {
shinyalert("Error", "Please upload a ZIP file", type = "error")
processing_status("error")
return()
}
# 解压文件
withProgress(
message = 'Extracting ZIP file',
detail = 'This may take a while...',
value = 0.5,
{
unzip(zip_file, exdir = target_dir)
}
)
# 显示成功消息
shinyalert("Success", "ZIP file uploaded and extracted successfully", type = "success")
} else if (input$ms1_source == "url") {
# 处理URL下载
req(input$ms1_url)
url <- input$ms1_url
# 验证URL格式
if (!grepl("^https?://", url)) {
shinyalert("Error", "Please enter a valid URL starting with http:// or https://", type = "error")
processing_status("error")
return()
}
if (!grepl("\\.zip$", url, ignore.case = TRUE)) {
shinyalert("Error", "URL must point to a .zip file", type = "error")
processing_status("error")
return()
}
# 创建临时文件
temp_zip <- tempfile(fileext = ".zip")
# 下载文件
withProgress(
message = 'Downloading ZIP file',
detail = 'This may take a while...',
value = 0.3,
{
tryCatch({
download.file(url, destfile = temp_zip, mode = "wb")
}, error = function(e) {
shinyalert("Download Failed", paste("Error:", e$message), type = "error")
processing_status("error")
return()
})
}
)
# 解压文件
withProgress(
message = 'Extracting files',
detail = 'Please wait...',
value = 0.6,
{
tryCatch({
unzip(temp_zip, exdir = target_dir)
}, error = function(e) {
shinyalert("Extraction Failed", paste("Error:", e$message), type = "error")
processing_status("error")
return()
})
}
)
# 删除临时文件
unlink(temp_zip)
# 显示成功消息
shinyalert("Success", "File downloaded and extracted successfully", type = "success")
}
# 检查并修正目录结构
withProgress(
message = 'Organizing directory structure',
detail = 'Checking folder layout...',
value = 0.9,
{
# 获取解压后的文件列表
extracted_files <- list.files(target_dir, full.names = TRUE)
# 修正1: 修复括号不匹配的if条件
if (length(extracted_files) == 1 && dir.exists(extracted_files[1])) {
subdir <- extracted_files[1]
subdir_name <- basename(subdir)
# 检查子目录是否包含POS/NEG目录
if (any(dir.exists(file.path(subdir, c("POS", "NEG"))))) {
# 移动内容到目标目录
move_files <- list.files(subdir, full.names = TRUE)
file.copy(move_files, target_dir, recursive = TRUE)
unlink(subdir, recursive = TRUE)
# 更新状态
shinyalert("Notice",
paste0("Files were moved from '", subdir_name,
"' to the main MS1 directory"),
type = "info")
}}
# 检查是否存在POS/NEG目录
pos_exists <- dir.exists(file.path(target_dir, "POS"))
neg_exists <- dir.exists(file.path(target_dir, "NEG"))
if (!pos_exists && !neg_exists) {
# 尝试查找可能的目录名称变体
possible_dirs <- list.files(target_dir, full.names = TRUE)
pos_dir <- possible_dirs[grep("pos|positive|POS|Positive", possible_dirs, ignore.case = TRUE)]
neg_dir <- possible_dirs[grep("neg|negative|NEG|Negative", possible_dirs, ignore.case = TRUE)]
# 重命名找到的目录
if (length(pos_dir) > 0) file.rename(pos_dir[1], file.path(target_dir, "POS"))
if (length(neg_dir) > 0) file.rename(neg_dir[1], file.path(target_dir, "NEG"))
}
}
)
# 设置MS1路径
ms1_path(target_dir)
processing_status("success")
}, error = function(e) {  # 修正2: 添加了tryCatch错误处理函数的右括号
shinyalert("Error", paste("Failed to process MS1 files:", e$message), type = "error")
processing_status("error")
})  # 修正3: 添加了tryCatch的右括号
})  # observeEvent结束
